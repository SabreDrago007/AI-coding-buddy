{
    "name": "ai-coding-buddy",
    "displayName": "AI Coding Buddy",
    "description": "A struggle-aware AI coding tutor for VS Code.",
    "version": "0.0.1",
    "publisher": "ai-coding-buddy",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Education",
        "Machine Learning"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",

    "contributes": {

        "commands": [
            {
                "command": "codingBuddy.getHint",
                "title": "AI Coding Buddy: Get Hint"
            },
            {
                "command": "codingBuddy.getLevel",
                "title": "AI Coding Buddy: Get Struggle Level"
            },
            {
                "command": "codingBuddy.runPython",
                "title": "AI Coding Buddy: Run Python File"
            },
            {
                "command": "codingBuddy.setLevel",
                "title": "AI Coding Buddy: Set Manual Level"
            },
            {
                "command": "codingBuddy.enableAutomatic",
                "title": "AI Coding Buddy: Return to Automatic Detection"
            },
            {
                "command": "codingBuddy.reset",
                "title": "AI Coding Buddy: Reset"
            },
            {
                "command": "codingBuddy.startLearningSession",
                "title": "AI Coding Buddy: Start Learning Session"
            },
            {
                "command": "codingBuddy.finishLearningSession",
                "title": "AI Coding Buddy: Finish Learning Session"
            }
        ],

        "configuration": {
            "title": "AI Coding Buddy",
            "properties": {

                "codingBuddy.level1TimeLimit": {
                    "type": "number",
                    "default": 10,
                    "minimum": 1,
                    "maximum": 3600,
                    "description": "Time in seconds to remain at Level 1 before automatic escalation to Level 2 when the Random Forest continues to detect higher struggle."
                },

                "codingBuddy.level2TimeLimit": {
                    "type": "number",
                    "default": 30,
                    "minimum": 1,
                    "maximum": 3600,
                    "description": "Time in seconds to remain at Level 2 before automatic escalation to Level 3 when the Random Forest continues to detect higher struggle."
                },

                "codingBuddy.level3TimeLimit": {
                    "type": "number",
                    "default": 60,
                    "minimum": 1,
                    "maximum": 3600,
                    "description": "Time in seconds used while the student remains at Level 3 before the system re-evaluates the assistance level."
                }

            }
        }
    },

    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },

    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.90.0",
        "typescript": "^5.0.0"
    }
}
